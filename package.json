{
  "name": "tienda-web",
  "private": true,
  "version": "0.0.0",
  "description": "Adargeyi: catálogo en línea. frontend/ = lo que ve el navegador, backend/ = servidor, datos y reglas de seguridad.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:infisical": "infisical run --env=dev --path=/ -- npm run dev",
    "build": "npm run build --workspace=frontend",
    "build:infisical": "infisical run --env=prod --path=/ -- npm run build",
    "preview": "npm run preview --workspace=frontend",
    "dev:backend": "npm run start --workspace=backend",
    "dev:backend:infisical": "infisical run --env=dev --path=/ -- npm run dev:backend",
    "procesar": "npm run procesar --workspace=backend",
    "seed:prueba": "npm run seed:prueba --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "seed:infisical": "infisical run --env=prod --path=/ -- npm run seed",
    "deploy:hosting": "npm run build && npx firebase-tools deploy --only hosting",
    "deploy:firebase": "npm run build && npx firebase-tools deploy --only hosting,firestore:rules",
    "deploy:firebase:infisical": "infisical run --env=prod --path=/ -- npm run deploy:firebase",
    "verificar-propietario": "npm run verificar-propietario --workspace=backend",
    "verificar-propietario:infisical": "infisical run --env=prod --path=/ -- npm run verificar-propietario"
  }
}
